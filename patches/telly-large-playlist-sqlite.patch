--- /dev/null
+++ b/app/src/main/java/com/johncorser/telly/features/epg/db/SqliteChunkedPrograms.kt
@@ -0,0 +1,29 @@
+package com.johncorser.telly.features.epg.db
+
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.flowOf
+
+/** Safe headroom below Android 9 SQLite's 999 bind-variable statement limit. */
+internal const val SQLITE_BIND_CHUNK = 900
+
+/**
+ * Room expands a List used by IN(...) into one bind variable per item.
+ * Split large channel-id lists so older Android SQLite builds never exceed
+ * their per-statement bind-variable limit, then restore DAO sort order.
+ */
+internal fun observeProgramsChunked(
+    tvgIds: List<String>,
+    query: (List<String>) -> Flow<List<ProgramEntity>>,
+): Flow<List<ProgramEntity>> {
+    val chunks = tvgIds.distinct().chunked(SQLITE_BIND_CHUNK)
+    if (chunks.isEmpty()) return flowOf(emptyList())
+    if (chunks.size == 1) return query(chunks.single())
+
+    val flows = chunks.map(query).toTypedArray()
+    return combine(*flows) { parts ->
+        parts
+            .flatMap { it }
+            .sortedWith(compareBy({ it.channelTvgId }, { it.startMs }))
+    }
+}
diff --git a/app/src/test/java/com/johncorser/telly/features/epg/db/SqliteChunkedProgramsTest.kt b/app/src/test/java/com/johncorser/telly/features/epg/db/SqliteChunkedProgramsTest.kt
