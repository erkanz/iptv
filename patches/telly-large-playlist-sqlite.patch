--- /dev/null
+++ b/app/src/test/java/com/johncorser/telly/features/epg/db/SqliteChunkedProgramsTest.kt
@@ -0,0 +1,47 @@
+package com.johncorser.telly.features.epg.db
+
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SqliteChunkedProgramsTest {
+    @Test
+    fun `3508 ids are split below the Android 9 SQLite bind limit`() =
+        runTest {
+            val ids = (1..3508).map { "channel-$it" }
+            val chunkSizes = mutableListOf<Int>()
+
+            val rows =
+                observeProgramsChunked(ids) { chunk ->
+                    chunkSizes += chunk.size
+                    flowOf(chunk.map(::program))
+                }.first()
+
+            assertEquals(listOf(900, 900, 900, 808), chunkSizes)
+            assertTrue(chunkSizes.all { it <= SQLITE_BIND_CHUNK })
+            assertEquals(3508, rows.size)
+        }
+
+    @Test
+    fun `duplicate ids are queried only once`() =
+        runTest {
+            val queried = mutableListOf<List<String>>()
+            observeProgramsChunked(listOf("a", "a", "b")) { chunk ->
+                queried += chunk
+                flowOf(emptyList())
+            }.first()
+
+            assertEquals(listOf(listOf("a", "b")), queried)
+        }
+
+    private fun program(tvgId: String) =
+        ProgramEntity(
+            channelTvgId = tvgId,
+            startMs = 0,
+            endMs = 1,
+            details = ProgramDetails(title = tvgId),
+        )
+}
